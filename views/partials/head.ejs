<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title><%= title || 'Bukti JP' %></title>
<link rel="stylesheet" href="/css/style.css">
<style>
body{margin:0;background:#050505;color:#fff;font-family:Arial}
.wrap{max-width:1200px;margin:auto;padding:20px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}
.card{background:#111;border-radius:18px;overflow:hidden}
.card img{width:100%;height:240px;object-fit:cover}
.btn{background:#d4af37;color:#000;padding:10px 16px;border-radius:10px;text-decoration:none;display:inline-block}
input,textarea{width:100%;padding:14px;border-radius:10px;border:none;background:#1a1a1a;color:#fff}
textarea{min-height:180px}
</style>
</head>
